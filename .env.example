# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# analytics.google.com → criar propriedade → Administrador → Fluxos de dados
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Firebase (Firestore — captura de leads) ──────────────────────────────────
# console.firebase.google.com → Configurações do projeto → Seus apps → SDK Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Meta Pixel (opcional) ────────────────────────────────────────────────────
# business.facebook.com → Gerenciador de Eventos → Pixels
NEXT_PUBLIC_META_PIXEL_ID=

# ─── TikTok Pixel (opcional) ──────────────────────────────────────────────────
# ads.tiktok.com → Assets → Events → Web Events → Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── Mercado Pago (reserva de pré-lançamento) ─────────────────────────────────
# SECRETO — usar SOMENTE no servidor. NÃO usar prefixo NEXT_PUBLIC.
# mercadopago.com.br → Suas integrações → Credenciais → Access Token
MERCADOPAGO_ACCESS_TOKEN=

# ─── Meta Conversions API (Purchase server-side — foco em venda) ───────────────
# SECRETO. business.facebook.com → Gerenciador de Eventos → Configurações →
# Conversions API → Gerar token de acesso. O pixel id reaproveita o NEXT_PUBLIC.
META_PIXEL_ID=
META_CAPI_TOKEN=

# ─── E-mail de confirmação (Resend) — opcional ────────────────────────────────
# SECRETO. resend.com → API Keys. EMAIL_FROM precisa de domínio verificado.
RESEND_API_KEY=
EMAIL_FROM=Sinesia <oi@sinesia.com.br>
